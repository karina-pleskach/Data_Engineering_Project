let
  Source = get_locations,
  #"Added custom 1" = Table.AddColumn(Source, "period", each "hours"),
  #"Merged queries" = Table.NestedJoin(#"Added custom 1", {"sensors.id"}, get_loadedTo_hours, {"sensors.id"}, "get_loadedTo_hours", JoinKind.LeftOuter),
  #"Expanded get_loadedTo_hours" = Table.ExpandTableColumn(#"Merged queries", "get_loadedTo_hours", {"measurement.loadedTo"}, {"measurement.loadedTo"}),
  #"Added custom 2" = Table.AddColumn(#"Expanded get_loadedTo_hours", "load_from", each [measurement.loadedTo], type nullable datetime),
  #"Added custom 3" = Table.AddColumn(#"Added custom 2", "load_to", each if [load_from] <> null then Date.AddMonths([load_from], 3) else null, type nullable datetime),
  Custom = Table.ToRecords(#"Added custom 3"),
  #"Custom 2" = List.Accumulate(
    Custom,
    {},
    (accumulated, current) =>
      let
        datetime_from = if current[load_from] <> null then DateTime.ToText(current[load_from], [Format = "yyyy-MM-ddTHH:mm:ss"]) & "Z" else null,
        datetime_to = if current[load_to] <> null then DateTime.ToText(current[load_to], [Format = "yyyy-MM-ddTHH:mm:ss"]) & "Z" else null,
        measurements = List.Buffer(get_measurements_by_sensor(current[#"sensors.id"], current[period], datetime_from, datetime_to)),
        records = List.Transform(measurements, (m) => Record.AddField(current, "measurement", m))
      in
        List.Combine({accumulated, records})),
  #"Converted to table" = Table.FromList(#"Custom 2", Splitter.SplitByNothing(), null, null, ExtraValues.Error),
  #"Expanded Column1" = Table.ExpandRecordColumn(#"Converted to table", "Column1", {"id", "name", "sensors.id", "sensors.name", "sensors.parameter.id", "sensors.parameter.name", "sensors.parameter.units", "sensors.parameter.displayName", "coordinates.latitude", "coordinates.longitude", "datetimeFirst.utc", "datetimeFirst.local", "datetimeLast.utc", "datetimeLast.local", "period", "measurement.loadedTo", "load_from", "load_to", "measurement"}, {"id", "name", "sensors.id", "sensors.name", "sensors.parameter.id", "sensors.parameter.name", "sensors.parameter.units", "sensors.parameter.displayName", "coordinates.latitude", "coordinates.longitude", "datetimeFirst.utc", "datetimeFirst.local", "datetimeLast.utc", "datetimeLast.local", "period", "measurement.loadedTo", "load_from", "load_to", "measurement"}),
  #"Expanded measurement 1" = Table.ExpandRecordColumn(#"Expanded Column1", "measurement", {"value", "flagInfo", "parameter", "period", "coordinates", "summary", "coverage"}, {"measurement.value", "measurement.flagInfo", "measurement.parameter", "measurement.period", "measurement.coordinates", "measurement.summary", "measurement.coverage"}),
  #"Expanded measurement.flagInfo" = Table.ExpandRecordColumn(#"Expanded measurement 1", "measurement.flagInfo", {"hasFlags"}, {"measurement.flagInfo.hasFlags"}),
  #"Removed columns" = Table.RemoveColumns(#"Expanded measurement.flagInfo", {"measurement.parameter"}),
  #"Expanded measurement.period" = Table.ExpandRecordColumn(#"Removed columns", "measurement.period", {"label", "interval", "datetimeFrom", "datetimeTo"}, {"measurement.period.label", "measurement.period.interval", "measurement.period.datetimeFrom", "measurement.period.datetimeTo"}),
  #"Expanded measurement.period.datetimeFrom" = Table.ExpandRecordColumn(#"Expanded measurement.period", "measurement.period.datetimeFrom", {"utc", "local"}, {"measurement.period.datetimeFrom.utc", "measurement.period.datetimeFrom.local"}),
  #"Expanded measurement.period.datetimeTo" = Table.ExpandRecordColumn(#"Expanded measurement.period.datetimeFrom", "measurement.period.datetimeTo", {"utc", "local"}, {"measurement.period.datetimeTo.utc", "measurement.period.datetimeTo.local"}),
  #"Expanded measurement.summary" = Table.ExpandRecordColumn(#"Expanded measurement.period.datetimeTo", "measurement.summary", {"min", "q02", "q25", "median", "q75", "q98", "max", "avg", "sd"}, {"measurement.summary.min", "measurement.summary.q02", "measurement.summary.q25", "measurement.summary.median", "measurement.summary.q75", "measurement.summary.q98", "measurement.summary.max", "measurement.summary.avg", "measurement.summary.sd"}),
  #"Expanded measurement.coverage" = Table.ExpandRecordColumn(#"Expanded measurement.summary", "measurement.coverage", {"expectedCount", "expectedInterval", "observedCount", "observedInterval", "percentComplete", "percentCoverage", "datetimeFrom", "datetimeTo"}, {"measurement.coverage.expectedCount", "measurement.coverage.expectedInterval", "measurement.coverage.observedCount", "measurement.coverage.observedInterval", "measurement.coverage.percentComplete", "measurement.coverage.percentCoverage", "measurement.coverage.datetimeFrom", "measurement.coverage.datetimeTo"}),
  #"Expanded measurement.coverage.datetimeFrom" = Table.ExpandRecordColumn(#"Expanded measurement.coverage", "measurement.coverage.datetimeFrom", {"utc", "local"}, {"measurement.coverage.datetimeFrom.utc", "measurement.coverage.datetimeFrom.local"}),
  #"Expanded measurement.coverage.datetimeTo" = Table.ExpandRecordColumn(#"Expanded measurement.coverage.datetimeFrom", "measurement.coverage.datetimeTo", {"utc", "local"}, {"measurement.coverage.datetimeTo.utc", "measurement.coverage.datetimeTo.local"}),
  #"Changed column type" = Table.TransformColumnTypes(#"Expanded measurement.coverage.datetimeTo", {{"id", Int64.Type}, {"name", type text}, {"sensors.id", Int64.Type}, {"sensors.name", type text}, {"sensors.parameter.id", Int64.Type}, {"sensors.parameter.name", type text}, {"sensors.parameter.units", type text}, {"sensors.parameter.displayName", type text}, {"coordinates.latitude", type number}, {"coordinates.longitude", type number}, {"datetimeFirst.utc", type datetime}, {"datetimeFirst.local", type text}, {"datetimeLast.utc", type datetime}, {"datetimeLast.local", type text}, {"period", type text}, {"measurement.value", type number}, {"measurement.flagInfo.hasFlags", type logical}, {"measurement.period.label", type text}, {"measurement.period.interval", type text}, {"measurement.period.datetimeFrom.utc", type datetime}, {"measurement.period.datetimeFrom.local", type text}, {"measurement.period.datetimeTo.utc", type datetime}, {"measurement.period.datetimeTo.local", type text}, {"measurement.coordinates", type text}, {"measurement.summary.min", type number}, {"measurement.summary.q02", type number}, {"measurement.summary.q25", type number}, {"measurement.summary.median", type number}, {"measurement.summary.q75", type number}, {"measurement.summary.q98", type number}, {"measurement.summary.max", type number}, {"measurement.summary.avg", type number}, {"measurement.summary.sd", type number}, {"measurement.coverage.expectedCount", Int64.Type}, {"measurement.coverage.expectedInterval", type text}, {"measurement.coverage.observedCount", Int64.Type}, {"measurement.coverage.observedInterval", type text}, {"measurement.coverage.percentComplete", Int64.Type}, {"measurement.coverage.percentCoverage", Int64.Type}, {"measurement.coverage.datetimeFrom.utc", type datetime}, {"measurement.coverage.datetimeFrom.local", type text}, {"measurement.coverage.datetimeTo.utc", type datetime}, {"measurement.coverage.datetimeTo.local", type text}})
in
